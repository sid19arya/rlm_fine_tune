# Copy to .env and fill in. .env is gitignored — never commit real values.

# RunPod: console -> Settings -> API Keys. MUST have write scope (the
# failsafe layer terminates pods; a read-only key is detected by the
# startup gate and fails the run loudly).
RUNPOD_API_KEY=

# Weights & Biases: wandb.ai/authorize
WANDB_API_KEY=

# Hugging Face: needed to pull Qwen3-8B and push the adapter before
# the pod's volume disk is destroyed on terminate.
HF_TOKEN=

# Optional notification sinks for rlmwatch
SLACK_WEBHOOK=
HEALTHCHECKS_URL=
